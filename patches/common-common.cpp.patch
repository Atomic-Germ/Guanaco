+++ b/common/common.cpp
@@ -1660,6 +1660,16 @@ struct llama_model_params common_model_params_to_llama(common_params & params) {
         mparams.devices = params.devices.data();
     }
 
+#ifdef GUANACO_ENABLED
+    // Guanaco streaming and gpu-pill read weights from the CPU file mmap;
+    // offloading to a GPU would move them to device memory and break both.
