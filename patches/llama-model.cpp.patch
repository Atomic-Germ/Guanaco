+void llama_model_base::allocate_uma_weights() {
+    if (!gpu_pill_active) {
+        return;
+    }
+
+    // Find the UMA buffer type from the first available device
+    ggml_backend_buffer_type_t uma_buft = nullptr;
+    for (const auto & dev : devices) {
+        uma_buft = ggml_backend_dev_get_uma_buft(dev.dev);
+        if (uma_buft != nullptr) {
+            break;
+        }
+    }
+
+    if (uma_buft == nullptr) {
+        LLAMA_LOG_WARN("%s: gpu_pill active but no UMA buffer type found - weights stay in CPU memory\n", __func__);
+        return;
+    }
+
+    LLAMA_LOG_INFO("%s: allocating weight tensors in UMA host-visible memory\n", __func__);
+
+    size_t n_redirected = 0;
+    size_t n_skipped = 0;
+
+    for (ggml_context * ctx : uma_ctxs) {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            // Skip tensors already on a GPU device buffer (non-host)
+            if (t->buffer != nullptr && !ggml_backend_buffer_is_host(t->buffer)) {
+                n_skipped++;
+                continue;
+            }
+
+            // Skip empty tensors
+            const size_t nb = ggml_nbytes(t);
+            if (nb == 0) {
+                n_skipped++;
+                continue;
+            }
+
+            // Allocate UMA buffer and copy weights
+            ggml_backend_buffer_t uma_buf = ggml_backend_buft_alloc_buffer(uma_buft, nb);
+            if (uma_buf == nullptr) {
+                LLAMA_LOG_WARN("%s: failed to allocate UMA buffer for '%s' (%zu bytes) - keeping original buffer\n",
+                               __func__, ggml_get_name(t) ? ggml_get_name(t) : "(unnamed)", nb);
+                n_skipped++;
+                continue;
+            }
+
+            void * dst = ggml_backend_buffer_get_base(uma_buf);
+            if (dst == nullptr) {
+                ggml_backend_buffer_free(uma_buf);
+                n_skipped++;
+                continue;
+            }
+
+            memcpy(dst, t->data, nb);
+
+            // Redirect tensor to UMA buffer
+            ggml_backend_buffer_free(t->buffer);
+            t->buffer = uma_buf;
+            t->data = dst;
+            n_redirected++;
+        }
+    }
+
+    LLAMA_LOG_INFO("%s: UMA weight allocation: %zu redirected, %zu skipped\n", __func__, n_redirected, n_skipped);
+}
