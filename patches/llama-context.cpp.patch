+// state behind the chained cb_eval installed in llama_context's constructor.
+// Owned by llama_context, freed in ~llama_context after the scheduler is idle.
+struct guanaco_chained_cb {
+    ggml_backend_sched_eval_callback  user;
+    void *                            user_data;
+    guanaco::GuanacoModelHook *       hook;
+};
+
+// Router Prefetch: every time the MoE gating node (ffn_moe_topk-<il>) is
+// computed, read the selected expert ids and pread only those expert slices
+// from the GGUF into their slabs before mul_mat_id runs. Also marks layer
+// boundaries for the dense pager via "l_out-<il>".
+static bool guanaco_eval_callback(
+        struct ggml_tensor * t,
+        bool                 ask,
+        void *               user_data) {
+    if (ask || t == nullptr) {
+        return true; // called before compute; nothing to do
+    }
+    auto * hook = static_cast<guanaco::GuanacoModelHook *>(user_data);
+    if (hook == nullptr) {
+        return true;
+    }
+    const char * name = ggml_get_name(t);
+    if (name == nullptr) {
+        return true;
+    }
+    // Dense layer-window streaming: "l_out-<il>" is emitted once per
+    // transformer layer, so it marks the layer boundary for the pager.
+    if (strncmp(name, "l_out-", 6) == 0) {
+        hook->on_layer_boundary(atoi(name + 6));
+        return true;
+    }
+    if (strncmp(name, "ffn_moe_topk", 12) != 0) {
+        return true;
+    }
+    // runtime name is "ffn_moe_topk-<il>" (layer suffix)
+    int layer = -1;
+    const char * dash = strrchr(name, '-');
+    if (dash != nullptr) {
+        layer = atoi(dash + 1);
+    }
+    const int n = (int)(t->ne[0] * t->ne[1]); // n_expert_used * n_tokens
+    if (n <= 0 || t->buffer == nullptr) {
+        return true;
+    }
+    // the router node can run on a device backend (op_offload), where
+    // t->data is not host-readable, so read the ids through the backend
+    std::vector<int> router_ids(n);
+    ggml_backend_tensor_get(t, router_ids.data(), 0, n * sizeof(int));
+    hook->on_router_computed(layer, router_ids.data(), n);
+    return true;
+}
+
+static bool guanaco_chained_eval_callback(
+        struct ggml_tensor * t,
+        bool                 ask,
+        void *               user_data) {
+    auto * chain = static_cast<guanaco_chained_cb *>(user_data);
+    guanaco_eval_callback(t, ask, chain->hook);
+    if (chain->user != nullptr && t != nullptr) {
+        return chain->user(t, ask, chain->user_data);
+    }
+    return true;
+}
