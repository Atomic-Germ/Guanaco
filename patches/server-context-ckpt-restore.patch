diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 715477e2e..7e902b107 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -18,6 +18,12 @@
 #include "mtmd-helper.h"
 
 #include <algorithm>
+#include <fstream>
+#include <sstream>
+#ifdef GUANACO_ENABLED
+#include "guanaco/guanaco_affinity.h"
+#include "guanaco/guanaco_model_hook.h"
+#endif
 #include <cstddef>
 #include <cinttypes>
 #include <exception>
@@ -903,6 +909,10 @@ private:
 
     bool add_bos_token = true;
 
+    // Expert-affinity correlation table, kept alive for the duration of the
+    // server context (referenced by the draft model's SteppeLoader).
+    std::unique_ptr<guanaco::ExpertAffinityTable> affinity_table_;
+
     int32_t n_ctx; // total context for all clients / slots
 
     // set to llama_model_n_swa(model)
@@ -1188,6 +1198,70 @@ private:
                 params_base.speculative.draft.ctx_dft = ctx_dft;
             }
 
+#ifdef GUANACO_ENABLED
+        if (has_spec && !params_base.guanaco_affinity.empty()) {
+            auto* hook_dft = static_cast<guanaco::GuanacoModelHook*>(
+                llama_guanaco_get_hook(model_dft ? model_dft : model_tgt));
+            auto* hook_tgt = static_cast<guanaco::GuanacoModelHook*>(
+                llama_guanaco_get_hook(model_tgt));
+            if (hook_dft && hook_tgt) {
+                // Resolve warmup text: if the argument is a readable file, read it
+                std::string warmup_text;
+                FILE* fp = fopen(params_base.guanaco_affinity.c_str(), "rb");
+                if (fp) {
+                    fseek(fp, 0, SEEK_END);
+                    long len = ftell(fp);
+                    fseek(fp, 0, SEEK_SET);
+                    if (len > 0 && len < 1024*1024) {
+                        warmup_text.resize((size_t)len);
+                        size_t got = fread(&warmup_text[0], 1, (size_t)len, fp);
+                        warmup_text.resize(got);
+                        // Strip null bytes
+                        warmup_text.erase(
+                            std::remove(warmup_text.begin(), warmup_text.end(), '\0'),
+                            warmup_text.end());
+                        SRV_INF("expert-affinity warmup: loaded %zu bytes from '%s'\n",
+                                warmup_text.size(), params_base.guanaco_affinity.c_str());
+                    }
+                    fclose(fp);
+                } else {
+                    warmup_text = params_base.guanaco_affinity;
+                }
+                if (!warmup_text.empty()) {
+                SRV_INF("%s", "running expert-affinity warmup...\n");
+                llama_tokens tokens = common_tokenize(ctx_tgt, warmup_text, true, false);
+                if (!tokens.empty()) {
+                    auto collector = std::make_unique<guanaco::ExpertAffinityCollector>(256, 256, 64);
+                    std::vector<guanaco::GuanacoModelHook::RouterRecord> draft_rec;
+                    hook_dft->set_router_recorder(&draft_rec);
+                    for (auto tok : tokens) {
+                        llama_batch batch = llama_batch_get_one(&tok, 1);
+                        llama_decode(ctx_dft, batch);
+                    }
+                    hook_dft->set_router_recorder(nullptr);
+                    std::vector<guanaco::GuanacoModelHook::RouterRecord> tgt_rec;
+                    hook_tgt->set_router_recorder(&tgt_rec);
+                    for (auto tok : tokens) {
+                        llama_batch batch = llama_batch_get_one(&tok, 1);
+                        llama_decode(ctx_tgt, batch);
+                    }
+                    hook_tgt->set_router_recorder(nullptr);
+                    size_t n_pairs = std::min(draft_rec.size(), tgt_rec.size());
+                    for (size_t i = 0; i < n_pairs; ++i)
+                        collector->record(draft_rec[i].layer, draft_rec[i].expert_ids.data(),
+                            (int)draft_rec[i].expert_ids.size(), tgt_rec[i].expert_ids.data(),
+                            (int)tgt_rec[i].expert_ids.size());
+                    auto table = collector->finalize(0.05f);
+                    SRV_INF("expert-affinity warmup complete: %zu tokens, %zu pairs, %zu layers\n",
+                        (size_t)tokens.size(), n_pairs, table->layers.size());
+                    hook_dft->set_affinity_table(table.get());
+                    affinity_table_ = std::move(table);
+                } // if (!tokens.empty())
+            } // if (!warmup_text.empty())
+            } // if (hook_dft && hook_tgt)
+        } // if (has_spec && ...)
+#endif
+
             load_progress_callback(1.0f, &load_progress_spec);
         }
 
